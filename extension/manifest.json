{
  "manifest_version": 3,
  "name": "FB Group Members Scraper",
  "short_name": "FB Scraper",
  "version": "1.0.0",
  "description": "Export Facebook group members to CSV. Free and open source, everything stays in your browser. Not affiliated with Meta.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
