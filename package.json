{
  "name": "facebook-group-members-scraper",
  "scripts": {
    "minify": "uglifyjs --compress --mangle --output dist/main.min.js -- dist/main.mjs && node -e \"require('fs').appendFileSync('dist/main.min.js', '\\n')\"",
    "build-vite": "tsc && vite build && vite build --config vite.extension.config.ts && vite build --config vite.license.config.ts",
    "build": "npm run build-vite && npm run minify && build-readme README.md",
    "test": "node --test test/*.test.ts"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ikerin/build-readme": "^1.1.1",
    "@phosphor-icons/core": "^2.1.1",
    "browser-scraping-utils": "git+https://github.com/floriandiud/browser-scraping-utils#0.2.0",
    "typescript": "5",
    "uglify-js": "^3.15.1",
    "vite": "^5.0.12",
    "vite-tsconfig-paths": "^4.3.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^20.11.7"
  }
}
